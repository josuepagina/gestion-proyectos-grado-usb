{
  "services": [
    {
      "name": "api",
      "rootDirectory": "backend",
      "framework": "express"
    },
    {
      "name": "web",
      "rootDirectory": "frontend",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/web/$1"
    }
  ]
}
