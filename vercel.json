{
  "services": [
    {
      "name": "api",
      "rootDirectory": "backend",
      "framework": "express"
    },
    {
      "name": "web",
      "rootDirectory": "frontend",
      "framework": "vite"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/web/$1"
    }
  ]
}
